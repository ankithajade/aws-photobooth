# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your authorized AWS credentials.
# Note: .streamlit/secrets.toml is listed in .gitignore and must NEVER be committed to Git.

AWS_ACCESS_KEY_ID = "YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY = "YOUR_AWS_SECRET_ACCESS_KEY"
AWS_DEFAULT_REGION = "ap-south-1"
S3_BUCKET = "your-hackathon-photostrip-bucket"

# Optional: Set to true if your S3 bucket has public read policy configured.
# If false (default), secure 48-hour presigned URLs are generated automatically.
S3_USE_PUBLIC_URLS = false

# Optional: If using temporary session credentials (e.g. AWS Academy or IAM STS AssumeRole)
# AWS_SESSION_TOKEN = "YOUR_SESSION_TOKEN"
